# Copy this file to backend/.env (or the project-root .env) and fill in your
# SMTP details. Without these values, 8search still works — emails are printed
# to the server console instead (including the password-reset link).
#
# Gmail: enable 2-Step Verification, then create an App Password at
# https://myaccount.google.com/apppasswords and use it as SMTP_PASSWORD.

SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
# Must be the Google account that created the App Password.
SMTP_USER="you@gmail.com"
SMTP_PASSWORD="your-16-character-app-password"
SMTP_FROM="8search <you@gmail.com>"

# starttls (587) | ssl (465) | none
SMTP_SECURITY=starttls

# Used in links inside emails.
APP_BASE_URL=http://localhost:8000

# Where feedback submitted through the website is sent.
FEEDBACK_EMAIL="vaibhavtripathi589@gmail.com"

# ── Scaling / performance (all optional) ────────────────────────────────
# Shared cache + rate limits across workers/replicas. Leave unset locally.
# REDIS_URL=redis://localhost:6379/0
SEARCH_CACHE_TTL=300
CACHE_MAX_ITEMS=5000
SEARCH_CONCURRENCY=64
SEARCH_QUEUE_TIMEOUT=5
SEARCH_TIMEOUT=7
NEWS_TIMEOUT=6
META_TIMEOUT=5
ANSWER_SOURCE_TIMEOUT=4
VIDEO_TIMEOUT=6
DDGS_CONCURRENCY=6
DDGS_TIMEOUT=4
DDGS_VIDEO_CONCURRENCY=3
DDGS_VIDEO_TIMEOUT=4
RATE_LIMIT_PER_MINUTE=120
TRUST_PROXY=0
# ALLOWED_ORIGINS=http://localhost:8000
# DISABLE_LOCAL_INDEX=0
# HTTP_MAX_CONNECTIONS=200
