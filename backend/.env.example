# Copy this file to backend/.env (or the project-root .env) and fill in your
# SMTP details. Without these values, 8search still works — emails are printed
# to the server console instead (including the password-reset link).
#
# Gmail: enable 2-Step Verification, then create an App Password at
# https://myaccount.google.com/apppasswords and use it as SMTP_PASSWORD.

SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
# Must be the Google account that created the App Password.
SMTP_USER="you@gmail.com"
SMTP_PASSWORD="your-16-character-app-password"
SMTP_FROM="8search <you@gmail.com>"

# starttls (587) | ssl (465) | none
SMTP_SECURITY=starttls

# Used in links inside emails.
APP_BASE_URL=http://localhost:8000

# ── Browser search engine / HTTPS ───────────────────────────────────────
# Serve /search, /opensearch.xml and /set-default with the right public URLs.
# APP_BASE_URL above is used for links; these control proxy and cookie safety.
TRUST_PROXY=0
FORCE_HTTPS=0
# COOKIE_SECURE overrides auto-detection (1 on production HTTPS).
# COOKIE_SECURE=1
# Comma-separated exact origins when cookies are used cross-site.
# ALLOWED_ORIGINS=https://search.example.com

# Free searches before a guest is asked to sign in.
GUEST_SEARCH_LIMIT=4
# Autocomplete has its own IP budget and never consumes search quota.
SUGGEST_RATE_LIMIT_PER_MINUTE=600
# Wikipedia fallback budget for a cold suggestion (cached hits are immediate).
# SUGGEST_WIKI_TIMEOUT=0.75
# Contact address sent to Wikipedia in the suggestion User-Agent.
# SUGGEST_CONTACT_EMAIL=you@example.com

# ── Trending News (real publisher RSS, refreshed every six hours) ───────
NEWS_REFRESH_HOURS=6
NEWS_COUNT=25
NEWS_MAX_AGE_HOURS=48
NEWS_FEED_TIMEOUT=6
# NEWS_DB_PATH=data/news.db
# Contact address sent to publishers in the feed User-Agent.
# NEWS_CONTACT_EMAIL=news@example.com
# Required to POST /api/news/refresh (X-News-Token or Authorization: Bearer).
# NEWS_ADMIN_TOKEN=replace-with-a-long-random-token
# Optional licensed GNews API; the RSS sources work without it.
# GNEWS_API_KEY=
# Optional licensed NewsAPI alias.
# NEWSAPI_KEY=

# Where feedback submitted through the website is sent.
FEEDBACK_EMAIL="vaibhavtripathi589@gmail.com"

# ── Scaling / performance (all optional) ────────────────────────────────
# Shared cache + rate limits across workers/replicas. Leave unset locally.
# REDIS_URL=redis://localhost:6379/0
SEARCH_CACHE_TTL=300
CACHE_MAX_ITEMS=5000
SEARCH_CONCURRENCY=64
SEARCH_QUEUE_TIMEOUT=5
SEARCH_TIMEOUT=7
NEWS_TIMEOUT=6
META_TIMEOUT=5
ANSWER_SOURCE_TIMEOUT=4
VIDEO_TIMEOUT=6
DDGS_CONCURRENCY=6
DDGS_TIMEOUT=4
DDGS_VIDEO_CONCURRENCY=3
DDGS_VIDEO_TIMEOUT=4
RATE_LIMIT_PER_MINUTE=120
TRUST_PROXY=0
# ALLOWED_ORIGINS=http://localhost:8000
# DISABLE_LOCAL_INDEX=0
# HTTP_MAX_CONNECTIONS=200

# ── Click-popularity ranking (all optional) ─────────────────────────────
# Set the same CLICK_TOKEN_SECRET on every replica in production. Local
# installs generate data/.click_secret automatically and persist it.
# CLICK_TOKEN_SECRET=replace-with-a-long-random-string
# CLICKS_DB_PATH=data/clicks.db
# CLICK_HALF_LIFE_DAYS=30
# MAX_POSITION_WEIGHT=5
# CLICK_DEDUPE_SECONDS=3600
# CLICK_RATE_PER_MINUTE=60
# CLICK_SESSION_RATE_PER_MINUTE=20
# CLICK_TOKEN_TTL_SECONDS=21600
# CLICK_RETENTION_DAYS=90
# RANKING_DEBUG=0
# RANKING_DEBUG_TOKEN=change-me
