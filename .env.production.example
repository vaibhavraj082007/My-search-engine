# Copy to .env for docker-compose.prod.yml and fill in real values.
# Never commit .env.

# ── Public origin and HTTPS ─────────────────────────────────────────────
# The exact public origin, with no trailing slash.
APP_BASE_URL=https://search.example.com
# Domain (or localhost for an internal test) that Caddy serves.
SITE_ADDRESS=search.example.com
# Let's Encrypt registration address used by Caddy.
ACME_EMAIL=admin@example.com

# Trust only the reverse proxy in front of the app. Never expose port 8000.
TRUST_PROXY=1
FORCE_HTTPS=1
COOKIE_SECURE=1
ALLOWED_ORIGINS=https://search.example.com

# ── App ─────────────────────────────────────────────────────────────────
PORT=8000
WEB_CONCURRENCY=4
REDIS_URL=redis://redis:6379/0
SEARCH_CACHE_TTL=300
CACHE_MAX_ITEMS=5000
SEARCH_CONCURRENCY=64
SEARCH_QUEUE_TIMEOUT=5
SEARCH_TIMEOUT=7
# Per-IP API budget. 600/min allows shared NAT (offices, campuses) while the
# separate click limit still protects the ranking endpoint.
RATE_LIMIT_PER_MINUTE=600
SUGGEST_RATE_LIMIT_PER_MINUTE=1200
GUEST_SEARCH_LIMIT=4

# ── Durability ──────────────────────────────────────────────────────────
# SQLite data is bind-mounted from ./data. The backup service writes verified
# snapshots to ./backups every BACKUP_INTERVAL_SECONDS and keeps
# BACKUP_KEEP_DAYS of them.
BACKUP_KEEP_DAYS=30
BACKUP_INTERVAL_SECONDS=21600
CLICK_TOKEN_SECRET=replace-with-a-long-random-string

# ── Trending News ───────────────────────────────────────────────────────
# Refresh every six hours; snapshots are kept while a refresh runs.
NEWS_REFRESH_HOURS=6
NEWS_COUNT=25
NEWS_MAX_AGE_HOURS=48
NEWS_FEED_TIMEOUT=6
NEWS_DB_PATH=/app/data/news.db
# A long random secret is required to POST /api/news/refresh.
# Generate one with: python -c "import secrets; print(secrets.token_urlsafe(32))"
NEWS_ADMIN_TOKEN=replace-with-a-long-random-token
NEWS_CONTACT_EMAIL=news@example.com
# Optional licensed GNews API. The RSS feed list works without it.
# GNEWS_API_KEY=

# ── Email (welcome, sign-in, reset, feedback) ───────────────────────────
SMTP_HOST=smtp.example.com
SMTP_PORT=587
SMTP_USER="you@example.com"
SMTP_PASSWORD="app-password"
SMTP_FROM="8search <you@example.com>"
SMTP_SECURITY=starttls
FEEDBACK_EMAIL="you@example.com"

# ── Click ranking ───────────────────────────────────────────────────────
# Use the same secret on every app replica.
# CLICK_TOKEN_SECRET=replace-with-a-long-random-string
# CLICK_RETENTION_DAYS=90
# RANKING_DEBUG=0
# RANKING_DEBUG_TOKEN=change-me
